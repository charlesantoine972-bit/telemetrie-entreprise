{
  "name": "telemetrie-entreprise",
  "version": "0.12.5",
  "description": "Truck & Coach Hub - télémétrie, carrière, entreprise et mods pour ETS2 / ATS",
  "author": "charlesantoine972-bit",
  "main": "main.js",
  "repository": "https://github.com/charlesantoine972-bit/telemetrie-entreprise",
  "scripts": {
    "test": "node --test tools/verify.test.js",
    "verify-games": "node tools/verify-game-content.js",
    "start": "electron .",
    "dist": "electron-builder --win nsis --x64",
    "release": "electron-builder --win nsis --x64 --publish always",
    "simulateur": "node tools/simulateur.js",
    "build-plugin": "sh plugin/build.sh"
  },
  "build": {
    "appId": "fr.telemetrie.entreprise",
    "productName": "Truck and Coach Hub",
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "app/**/*"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Truck & Coach Hub",
      "artifactName": "Truck-and-Coach-Hub-Setup-${version}.exe"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "charlesantoine972-bit",
        "repo": "telemetrie-entreprise",
        "releaseType": "release"
      }
    ],
    "directories": {
      "output": "dist"
    },
    "extraResources": [
      {
        "from": "resources/plugin",
        "to": "plugin"
      },
      {
        "from": "resources/tools",
        "to": "tools"
      }
    ]
  },
  "dependencies": {
    "discord-rpc": "^4.0.1",
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  }
}
